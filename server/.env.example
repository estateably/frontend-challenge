# Copy to server/.env to override. Every value below is the default.

# Port the API listens on.
PORT=4000

# Allowed CORS origin. Unset means "reflect whatever origin asks", which is what
# you want while the client's dev port is still moving around.
# CORS_ORIGIN=http://localhost:5173

# Months of history to generate (1-60).
SEED_MONTHS=18

# Multiplies discretionary transaction volume (0.1-10). 1 gives ~1,100 rows,
# 10 gives ~6,600.
SEED_SCALE=1
